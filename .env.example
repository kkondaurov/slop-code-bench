# Optional headless Docker setup for macOS with Colima.
# Copy to .env and replace the paths with absolute paths for your machine.
DOCKER_HOST=unix:///Users/you/.colima/default/docker.sock
SLOP_CODE_TMPDIR=/Users/you/.cache/slopcodebench

# Optional override. `UV_NO_CONFIG=1 uv sync --frozen` installs the pinned default.
# AST_GREP_BIN=/absolute/path/to/sg
